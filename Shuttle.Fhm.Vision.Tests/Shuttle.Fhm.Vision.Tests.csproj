<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
        <!-- Allow restore/compile of this Windows-only project on non-Windows CI agents
             (e.g. the Ubuntu build). Its tests are only executed on Windows. -->
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <UseWindowsForms>true</UseWindowsForms>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="SixLabors.ImageSharp" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shuttle.Fhm.Vision\Shuttle.Fhm.Vision.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
        <!-- WinForms (UseWindowsForms) adds a global System.Drawing using that clashes with
             SixLabors.ImageSharp.Image in these tests; drop it and qualify where needed. -->
        <Using Remove="System.Drawing" />
    </ItemGroup>

    <ItemGroup>
        <!-- Temporary ImageSharp exceptions for non-production Vision tooling; remove on upgrade. -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    </ItemGroup>

</Project>
