<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
        <!-- Allow restore/compile of this Windows-only project on non-Windows CI agents
             (e.g. the Ubuntu build). It still only runs on Windows. -->
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Shuttle.Fhm.Vision</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Commandline" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="SixLabors.ImageSharp" />
        <PackageReference Include="CoenM.ImageSharp.ImageHash" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <!-- Pull the patched native SQLite bundle so the vulnerable transitive
             SQLitePCLRaw.lib.e_sqlite3 pulled by EF Core is overridden. -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    </ItemGroup>

    <ItemGroup>
        <!-- Temporary ImageSharp exceptions for non-production Vision tooling; remove on upgrade. -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    </ItemGroup>

</Project>
