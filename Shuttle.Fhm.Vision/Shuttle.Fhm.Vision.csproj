<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Shuttle.Fhm.Vision</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Commandline" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="SixLabors.ImageSharp" />
        <PackageReference Include="CoenM.ImageSharp.ImageHash" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <!-- Pull the patched native SQLite bundle so the vulnerable transitive
             SQLitePCLRaw.lib.e_sqlite3 pulled by EF Core is overridden. -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    </ItemGroup>

</Project>
