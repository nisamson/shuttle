@using Shuttle.Models.Players
@using Shuttle.Shl.Api.Models.Common
@using Shuttle.Shl.Api.Models.Portal.V1

@{
    // Fully controlled sort header: the indicator reflects the SortField/SortDescending parameters
    // (so it stays correct when sort changes via URL/back-navigation, not just header clicks), and a
    // click raises SortChanged to the parent. No local grid sorting — Items are rendered as given.
    RenderFragment<(string Title, PlayerSortField Field)> SortHeader = spec =>
        @<span role="@(Sortable ? "button" : null)"
               style="@(Sortable ? "cursor: pointer; user-select: none;" : null); @(SortField == spec.Field ? "color: var(--accent-fill-rest);" : null)"
               @onclick="() => ToggleSort(spec.Field)">@spec.Title<span style="font-size: 0.85em;">@SortIndicator(spec.Field)</span></span>;
}

<div style="overflow-x: auto;">
<FluentDataGrid Items="@Rows" TGridItem="PlayerCard" Loading="Loading" Style="@GridStyle"
                GridTemplateColumns="@GridColumns">
    <ChildContent>
    @if (Selectable) {
        <SelectColumn TGridItem="PlayerCard"
                      SelectMode="DataGridSelectMode.Multiple"
                      SelectFromEntireRow="false"
                      SelectedItems="SelectedPlayers"
                      SelectedItemsChanged="SelectedPlayersChanged"/>
    }
    <TemplateColumn Title="Name" HeaderCellItemTemplate="@(_ => SortHeader(("Name", PlayerSortField.Name)))">
        <ShuttleLink Emphasized="true" Href="@PlayerRoute(context.PlayerId)">@context.Name</ShuttleLink>
    </TemplateColumn>
    <TemplateColumn Title="Username" HeaderCellItemTemplate="@(_ => SortHeader(("Username", PlayerSortField.Username)))">
        @if (context.UserId == SuppressUserLinkFor) {
            @context.Username
        } else {
            <ShuttleLink Href="@UserRoute(context.UserId)">@context.Username</ShuttleLink>
        }
    </TemplateColumn>
    <TemplateColumn Title="Pos" HeaderCellItemTemplate="@(_ => SortHeader(("Pos", PlayerSortField.Position)))">
        @context.Position.ToShortString()
    </TemplateColumn>
    <TemplateColumn Title="Status" HeaderCellItemTemplate="@(_ => SortHeader(("Status", PlayerSortField.Status)))">
        <FluentBadge Color="StatusColor(context.Status)">@StatusText(context.Status)</FluentBadge>
    </TemplateColumn>
    <TemplateColumn Title="League" HeaderCellItemTemplate="@(_ => SortHeader(("League", PlayerSortField.League)))">
        @(context.CurrentLeague?.Abbreviation ?? "—")
    </TemplateColumn>
    <TemplateColumn Title="Draft" HeaderCellItemTemplate="@(_ => SortHeader(("Draft", PlayerSortField.DraftSeason)))">
        <SeasonNumber Season="context.DraftSeason"/>
    </TemplateColumn>
    <TemplateColumn Title="Created" HeaderCellItemTemplate="@(_ => SortHeader(("Created", PlayerSortField.Created)))">
        @context.CreationDate.ToString("yyyy-MM-dd")
    </TemplateColumn>
    <TemplateColumn Title="Total TPE" Align="DataGridCellAlignment.End"
                    HeaderCellItemTemplate="@(_ => SortHeader(("Total TPE", PlayerSortField.TotalTpe)))">
        <span style="font-variant-numeric: tabular-nums;">@context.TotalTpe.ToString("N0")</span>
    </TemplateColumn>
    <TemplateColumn Title="Flags">
        @if (context.Recreate) {
            <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Success" title="Recreate — not the member's first player">Recreate</FluentBadge>
        } else {
            <FluentBadge Appearance="BadgeAppearance.Outline" Color="BadgeColor.Informative" title="Portal First-gen — the member's first player on the portal (they may have had players before the portal existed)">Portal First-gen</FluentBadge>
        }
        @if (context.Inactive) {
            <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Severe" title="Inactive on-site">Inactive</FluentBadge>
        }
        @if (context.IsSuspended) {
            <FluentBadge Appearance="BadgeAppearance.Outline" Color="BadgeColor.Danger" title="Suspended">Suspended</FluentBadge>
        }
    </TemplateColumn>
    </ChildContent>

    <LoadingContent>
        <FluentSpinner/> Loading players…
    </LoadingContent>
    <EmptyContent>
        No players match your filters.
    </EmptyContent>
</FluentDataGrid>
</div>
